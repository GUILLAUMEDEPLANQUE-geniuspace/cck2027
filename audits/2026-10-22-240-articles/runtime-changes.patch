--- 5.27.2/components/com_joomcck/media/nexus/editorial-collection-2026.js
+++ 5.27.3/components/com_joomcck/media/nexus/editorial-collection-2026.js
@@ -0,0 +1,29 @@
+/* Admin-only native import, one bounded universe at a time. No client-side secrets. */
+(() => {
+  'use strict';
+  document.querySelectorAll('form[data-editorial-collection]').forEach(form => {
+    const submit=form.querySelector('[type=submit]'),stop=form.querySelector('[data-collection-stop]');
+    const status=form.querySelector('[data-collection-status]'),receipts=form.querySelector('[data-collection-receipts]'),progress=form.querySelector('progress'),select=form.querySelector('[name=universe]');
+    let running=false,stopping=false;
+    stop.addEventListener('click',()=>{stopping=true;stop.disabled=true;status.textContent='Le lot en cours se termine avant l’arrêt. Vous pourrez reprendre ensuite.';});
+    form.addEventListener('submit',async event=>{
+      event.preventDefault();if(running)return;
+      running=true;stopping=false;submit.disabled=true;stop.disabled=false;
+      const keys=select.value==='all'?[...select.options].map(o=>o.value).filter(k=>k!=='all'):[select.value];
+      select.disabled=true;progress.hidden=false;progress.max=keys.length*20;progress.value=0;receipts.replaceChildren();
+      try{
+        for(const key of keys){
+          status.textContent='Publication de '+key+'… Gardez cette page ouverte.';
+          const data=new FormData(form);data.set('universe',key);
+          const response=await fetch(form.action,{method:'POST',body:data,credentials:'same-origin',headers:{Accept:'application/json'}});
+          const result=await response.json();if(!response.ok||result.error)throw new Error(result.error||'Lot indisponible. Réessayez pour reprendre.');
+          if(result.total!==20||Object.keys(result.articles||{}).length!==20)throw new Error('Le reçu de ce lot est incomplet. Reprenez pour vérifier ses articles.');
+          const li=document.createElement('li');li.textContent=result.label+' : 20 articles vérifiés, '+result.created+' créés et '+result.preserved+' conservés.';receipts.append(li);progress.value+=20;
+          if(stopping)break;
+        }
+        status.textContent=stopping?'Arrêt effectué entre deux lots. Les lots terminés sont conservés.':'Collection vérifiée : '+progress.value+' articles. Les publications existantes ont été conservées.';
+      }catch(error){status.textContent='Import interrompu : '+error.message;}
+      finally{running=false;submit.disabled=false;select.disabled=false;stop.disabled=true;}
+    });
+  });
+})();
